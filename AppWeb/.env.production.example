# Single-server deployment mode.
# Browser requests stay on the same host and Nginx proxies /api to backend.
VITE_API_MODE=relative

# AMap Web JS API key and its matching securityJsCode.
# For production, prefer an AMap serviceHost proxy instead of exposing securityJsCode.
VITE_AMAP_WEB_KEY=your-amap-web-js-api-key
VITE_AMAP_SECURITY_JS_CODE=your-amap-security-js-code

