# Default local development mode.
# Browser requests go directly to the Java backend on your machine.
VITE_API_MODE=local
VITE_API_BASE_URL=http://localhost:8080

# AMap Web JS API key and its matching securityJsCode.
# Create both under the same Web (JS API) key in the AMap console.
VITE_AMAP_WEB_KEY=your-amap-web-js-api-key
VITE_AMAP_SECURITY_JS_CODE=your-amap-security-js-code

