# Copy this file to AppBackend/.env, then fill real values locally.
# AppBackend/start-smart-campus.cmd automatically loads AppBackend/.env.
# Do not commit real SecretId/SecretKey. If a key has appeared in Git history, rotate it first.

# Optional: override the default datasource URL set by start-smart-campus scripts.
# The script default points to the host port mapped from the MySQL container (3307)
# and uses characterEncoding=UTF-8 (Java charset name; Connector/J then uses utf8mb4
# on the server side). Set this only when connecting to a different MySQL.
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/smart-campus?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai

TENCENT_COS_SECRET_ID=your-tencent-cos-secret-id
TENCENT_COS_SECRET_KEY=your-tencent-cos-secret-key
TENCENT_COS_REGION=ap-beijing
TENCENT_COS_BUCKET=your-bucket-name-with-appid
TENCENT_COS_DOMAIN=https://your-bucket.cos.ap-beijing.myqcloud.com

# AMap Web Service key used by backend POI search/geocoding.
AMAP_WEB_KEY=your-amap-web-service-key

