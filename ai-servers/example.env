# Service
PYTHON_SERVER_PORT=8081
LOG_LEVEL=INFO
LOG_HTTPX_LEVEL=WARNING
LOG_HTTPCORE_LEVEL=WARNING
LOG_UVICORN_ACCESS_LEVEL=WARNING

# LLM
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
# Java system_config can also select qwen as ai.service.text.provider.
# Qwen/Qwen-VL OpenAI-compatible base URL:
# ai.service.text.base-url=https://dashscope.aliyuncs.com/compatible-mode/v1
# Text model example: qwen-plus / qwen-max
# Vision model example: qwen-vl-plus / qwen-vl-max / qwen3-vl-plus

# Memory
REDIS_URL=redis://localhost:6379/0
LLM_MEMORY_TTL_MINUTES=120
LLM_MEMORY_MAX_MESSAGES=20

# Reuse Java backend APIs
JAVA_BACKEND_BASE_URL=http://localhost:8080
JAVA_BACKEND_TIMEOUT_SECONDS=8

# RAG
RAG_KNOWLEDGE_BASE_DIR=knowledge_base/raw
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_VECTOR_TOP_K=5
RAG_EMBEDDING_PROVIDER=local_lexical
RAG_VECTOR_STORE_BACKEND=milvus
RAG_GRAPH_STORE_BACKEND=local_graph
RAG_SQLITE_DB_PATH=

# Vector store scaffolds
RAG_FAISS_INDEX_DIR=knowledge_base/vector_store/faiss
RAG_MILVUS_URI=http://localhost:19530
RAG_MILVUS_COLLECTION=smart_campus_knowledge
RAG_MILVUS_PARENT_CHILD_COLLECTION=smart_campus_knowledge_parent_child
RAG_MILVUS_DIMENSION=384
RAG_MILVUS_METRIC_TYPE=COSINE
RAG_ELASTICSEARCH_URL=http://localhost:9200
RAG_ELASTICSEARCH_INDEX=smart_campus_knowledge
RAG_PGVECTOR_DSN=postgresql://user:password@localhost:5432/smart_campus
RAG_PGVECTOR_TABLE=rag_documents

# Embedding provider scaffolds
OPENAI_API_KEY=your-openai-api-key
RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DASHSCOPE_API_KEY=your-dashscope-api-key
RAG_DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# Qwen image generation
QWEN_IMAGE_API_KEY=your-dashscope-api-key
QWEN_IMAGE_BASE_URL=https://dashscope.aliyuncs.com
QWEN_IMAGE_MODEL=qwen-image-plus
QWEN_IMAGE_TIMEOUT_SECONDS=30
QWEN_IMAGE_POLL_INTERVAL_SECONDS=2
QWEN_IMAGE_MAX_POLL_ATTEMPTS=60
RAG_BGE_MODEL_NAME=BAAI/bge-m3
RAG_SENTENCE_TRANSFORMERS_MODEL=BAAI/bge-small-zh-v1.5

# Graph store scaffolds
RAG_NEO4J_URI=bolt://localhost:7687
RAG_NEO4J_USERNAME=neo4j
RAG_NEO4J_PASSWORD=your-neo4j-password
RAG_NEO4J_DATABASE=neo4j
RAG_NEO4J_SEARCH_CYPHER=
