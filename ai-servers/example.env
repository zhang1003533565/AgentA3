# Service
PYTHON_SERVER_PORT=8081
LOG_LEVEL=INFO
LOG_HTTPX_LEVEL=WARNING
LOG_HTTPCORE_LEVEL=WARNING
LOG_UVICORN_ACCESS_LEVEL=WARNING

# LLM
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# Memory
REDIS_URL=redis://localhost:6379/0
LLM_MEMORY_TTL_MINUTES=120
LLM_MEMORY_MAX_MESSAGES=20

# Reuse Java backend APIs
JAVA_BACKEND_BASE_URL=http://localhost:8080
JAVA_BACKEND_TIMEOUT_SECONDS=8
