# Copy to deploy/.env and replace every CHANGE_ME value before startup.
IMAGE_TAG=submission
BACKEND_IMAGE=agent-a3/backend
AI_SERVER_IMAGE=agent-a3/ai-server
WEB_IMAGE=agent-a3/web
MYSQL_IMAGE=mysql:8.4.5
REDIS_IMAGE=redis:7.4.2-alpine

MYSQL_DATABASE=smart-campus
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password
MYSQL_PORT=3306
REDIS_PORT=6379
BACKEND_PORT=8080
AI_PORT=8081
WEB_PORT=3000

JWT_SECRET=CHANGE_ME_use_at_least_64_random_characters_for_hmac_signing
AI_INTERNAL_TOKEN=CHANGE_ME_use_a_separate_random_secret_for_java_python_calls
JWT_EXPIRATION_MS=86400000
JAVA_TOOL_OPTIONS=-Xms256m -Xmx1024m
PUBLIC_BASE_URL=http://localhost:3000

# Optional map/object-storage integrations. Empty values keep unrelated campus
# pages bootable, but their external-provider actions require real credentials.
TENCENT_MAP_KEY=
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
AMAP_APP_KEY=
AMAP_WEB_KEY=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=

# External MaxKB and model values are intentionally not baked into images.
# Configure them in the administrator UI after boot; keep this section as the
# local handoff record and never commit deploy/.env.
MAXKB_BASE_URL=
MAXKB_API_KEY=
MAXKB_WORKSPACE_ID=
MAXKB_KNOWLEDGE_ID=
LLM_PROVIDER=xfyun
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Evaluation scripts use these only when a live authenticated environment exists.
EVAL_ENDPOINT=
EVAL_TOKEN=
