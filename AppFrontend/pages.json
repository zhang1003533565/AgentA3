	],
	"preloadRule": {
		"pages/index/index": {
			"network": "all",
			"packages": ["subpackage_activity"]
		}
	},
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "智慧校园",
		"navigationBarBackgroundColor": "#FFFFFF",
